{
  "name": "@vora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API VORA — Fastify + Socket.IO + Drizzle + PostgreSQL/PostGIS",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "db:setup": "node ../../scripts/db-setup.mjs",
    "db:reset": "node ../../scripts/db-setup.mjs --reset",
    "db:psql": "node ../../scripts/db-shell.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed/index.ts",
    "demo": "tsx src/demo/reset.ts",
    "test": "node ../../scripts/test-db.mjs",
    "test:unit": "vitest run unit.test",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/merge-json-schemas": "^0.2.1",
    "@fastify/rate-limit": "^10.1.1",
    "@pinojs/redact": "^0.4.0",
    "accepts": "^1.3.8",
    "atomic-sleep": "^1.0.0",
    "base64id": "^2.0.0",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "engine.io-parser": "^5.2.3",
    "fast-copy": "^4.1.1",
    "fast-deep-equal": "^3.1.3",
    "fast-querystring": "^1.1.2",
    "fast-safe-stringify": "^2.1.1",
    "fastfall": "^1.5.1",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "fastparallel": "^2.4.1",
    "fastseries": "^1.7.2",
    "obliterator": "^2.0.5",
    "on-exit-leak-free": "^2.1.2",
    "pg": "^8.23.0",
    "pg-int8": "^1.0.1",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "pino-pretty": "^13.0.0",
    "pino-std-serializers": "^7.1.0",
    "postgres-array": "^2.0.0",
    "postgres-bytea": "^1.0.0",
    "postgres-date": "^1.0.7",
    "postgres-interval": "^1.2.0",
    "quick-format-unescaped": "^4.0.4",
    "real-require": "^1.0.0",
    "reusify": "^1.1.0",
    "safe-regex2": "^5.1.1",
    "safe-stable-stringify": "^2.5.0",
    "set-cookie-parser": "^3.1.2",
    "socket.io": "^4.8.1",
    "socket.io-adapter": "^2.5.8",
    "socket.io-parser": "^4.2.7",
    "sonic-boom": "^5.0.1",
    "ws": "^8.21.3",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@drizzle-team/brocli": "^0.12.1",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.1",
    "@vitest/pretty-format": "^2.1.9",
    "colorette": "^2.0.20",
    "dateformat": "^4.6.3",
    "dequal": "^2.0.3",
    "drizzle-kit": "^0.28.1",
    "help-me": "^5.0.0",
    "joycon": "^3.1.1",
    "minimist": "^1.2.8",
    "pump": "^3.0.4",
    "socket.io-client": "^4.8.3",
    "strip-json-comments": "^5.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
