# VORA — variables d'environnement. Copier en `.env` : cp .env.example .env
# Aucun secret réel dans ce fichier ni dans le dépôt.

# ─── Base de données ──────────────────────────────────────────────────────────
# PostgreSQL 16 + PostGIS installé LOCALEMENT sur la machine (pas de Docker en développement).
# Création du rôle, de la base et des extensions : npm run db:setup — voir CLAUDE.md § 4.
DATABASE_URL=postgresql://vora:vora@localhost:5432/vora
# Chiffre la connexion à PostgreSQL sans exiger que Node reconnaisse le certificat du serveur.
# Laissez false en local ; mettez true sur un add-on géré (Clever Cloud) — voir
# infra/deploy/CLEVER_CLOUD.md. En déploiement, POSTGRESQL_ADDON_URI est accepté à la place
# de DATABASE_URL : rien à recopier à la main.
DATABASE_SSL=false
# Délai pour ÉTABLIR une connexion. 5 s suffisaient en local ; contre une base gérée et
# distante, la seule poignée de main TLS coûte 1 à 2 s. Relevez si vous voyez
# « Connection terminated due to connection timeout ».
DATABASE_CONNECT_TIMEOUT_MS=10000
# Applique les migrations au démarrage de l'API. true partout par défaut : en local c'est un
# no-op de quelques millisecondes, en production c'est ce qui interdit à une base en retard
# sur le code de servir des erreurs. L'API ne démarre pas si une migration échoue.
MIGRATE_ON_BOOT=true

# Base des tests d'intégration : créée et détruite par `npm test`. Par défaut, c'est la base
# ci-dessus suffixée _test (vora_test) sur le même serveur — ne décommentez que si vous en voulez
# une autre, et donnez-lui impérativement un nom différent de la base de développement.
# TEST_DATABASE_URL=postgresql://vora:vora@localhost:5432/vora_test

# Utilisées uniquement par infra/docker/docker-compose.prod.yml (déploiement cible).
POSTGRES_USER=vora
POSTGRES_PASSWORD=vora
POSTGRES_DB=vora

# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TZ=Africa/Douala
# Origines autorisées pour l'admin web et la page de partage de trajet (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Sert GET /openapi.json et GET /docs (Swagger UI). false pour les refermer.
DOCS_ENABLED=true
# Renseignée automatiquement par la plateforme sur un déploiement git ; exposée par /health.
# COMMIT_ID=

# ─── Sécurité ─────────────────────────────────────────────────────────────────
# À remplacer par une valeur aléatoire : openssl rand -hex 32
JWT_SECRET=changeme-dev-only
JWT_EXPIRES_IN=24h
# Signature HMAC du devis : garantit que le prix ferme n'a pas été modifié par le client
QUOTE_HMAC_SECRET=changeme-dev-only
# Durée de vie et tolérance d'un code de vérification
OTP_TTL_S=300
OTP_MAX_ATTEMPTS=5

# ─── Partage de trajet ────────────────────────────────────────────────────────
# Base des liens publics « Partager mon trajet ». Le lien s'ouvre dans le navigateur
# d'un proche, hors de l'application : mettez ici une adresse joignable de l'extérieur
# (l'IP de la machine sur le réseau du hackathon, par exemple).
PUBLIC_BASE_URL=http://localhost:3000
# Durée de validité du lien, en secondes. 4 h : le trajet, plus la marge.
SHARE_LINK_TTL_S=14400

# ─── Mode démonstration ───────────────────────────────────────────────────────
# true : le code OTP vaut toujours DEMO_OTP_CODE, il est renvoyé dans la réponse et affiché en log,
#        le simulateur de chauffeurs et les endpoints /v1/demo/* sont actifs.
# false : comportement de production. Le produit doit fonctionner sans le simulateur.
DEMO_MODE=true
DEMO_OTP_CODE=123456
# Jeton exigé par GET /v1/demo/status, POST /v1/demo/reset et /v1/demo/scenario
# (en-tête X-Demo-Token)
DEMO_CONTROL_TOKEN=vora-demo
# Accélération de l'approche ET de la course simulées. ×8 : une course de 20 min en 2 min 30.
DEMO_RIDE_SPEEDUP=8
# Le chauffeur simulé accepte entre ces deux délais : assez pour voir tourner le compte à rebours.
DEMO_ACCEPT_MIN_S=4
DEMO_ACCEPT_MAX_S=8
# Pause après « Je suis arrivé », le temps de montrer le code sur le téléphone.
DEMO_BOARDING_PAUSE_S=6
# La taille de la flotte (8 voitures, 4 motos) est fixée dans src/demo/fleet.ts : ce sont
# des personnes avec des noms et des plaques, pas un nombre à régler.

# ─── Routage : OSRM public, repli haversine ───────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=2000
# false : force le repli haversine sans débrancher le réseau. Sert à ESSAYER le repli
# avant de passer devant le jury, comme l'exige CLAUDE.md § 3.
OSRM_ENABLED=true
# Repli si OSRM échoue ou dépasse le délai : distance à vol d'oiseau × facteur, à cette vitesse
FALLBACK_DISTANCE_FACTOR=1.35
FALLBACK_SPEED_KMH=22

# ─── Dispatch (valeurs du brief § 6 — ne pas modifier sans changer CLAUDE.md) ──
DISPATCH_OFFER_TIMEOUT_S=15
DISPATCH_MAX_WAVES=3
DISPATCH_RADII_KM=1,3,5
DRIVER_POSITION_TTL_S=60
# La fenêtre de rejeu (10 min) est une constante de realtime/bus.ts, pas un réglage.

# ─── Tarification ─────────────────────────────────────────────────────────────
QUOTE_TTL_S=120
# La majoration pluie n'est PAS une variable d'environnement : elle s'active en direct par
# POST /v1/ops/surge, et son plafond (50 %) est une règle métier de domain/rules.ts.

# ─── Paiement ─────────────────────────────────────────────────────────────────
# simulated : adaptateur de démonstration (attente puis succès). Aucune API opérateur réelle.
PAYMENT_PROVIDER=simulated
PAYMENT_SIMULATED_DELAY_MS=3000

# ─── Assistant de support (POST /v1/support/ask) ──────────────────────────────
# Module ISOLÉ : aucun devis, aucune commande, aucun dispatch, aucun paiement n'en dépend.
# Les quatre variables sont vides par défaut, et l'assistant répond quand même — à partir
# de la FAQ seule, sans réseau. Renseignez-les pour qu'il reformule au lieu de recopier.
#
# false : FAQ seule, aucun appel réseau (mode par défaut, et celui de la démonstration si
#         la salle n'a pas d'internet). true : le modèle est tenté, avec repli automatique
#         sur la FAQ si la clé manque, si l'appel échoue ou s'il dépasse 4 s.
LLM_ENABLED=false
# Racine d'une API compatible OpenAI, SANS /chat/completions. Exemples d'offres gratuites :
#   OpenRouter  https://openrouter.ai/api/v1        (modèles suffixés « :free »)
#   Groq        https://api.groq.com/openai/v1      (palier gratuit, très rapide)
#   llama.cpp / Ollama en local : http://localhost:11434/v1
LLM_BASE_URL=
# Identifiant du modèle chez ce fournisseur. Un petit modèle suffit : il ne fait que mettre
# en phrases un contexte déjà écrit par le serveur. Ex. « llama-3.3-70b-versatile » (Groq)
# ou « meta-llama/llama-3.3-70b-instruct:free » (OpenRouter). La liste des modèles gratuits
# bouge : vérifiez-la chez le fournisseur avant la démonstration.
LLM_MODEL=
# SECRET. Jamais de valeur dans ce fichier ni dans le dépôt.
LLM_API_KEY=

# ─── Admin web (apps/admin, Vite) ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
