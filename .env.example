# VORA — variables d'environnement. Copier en `.env` : cp .env.example .env
# Aucun secret réel dans ce fichier ni dans le dépôt.

# ─── Base de données ──────────────────────────────────────────────────────────
# PostgreSQL 16 + PostGIS installé LOCALEMENT sur la machine (pas de Docker en développement).
# Création du rôle, de la base et des extensions : npm run db:setup — voir CLAUDE.md § 4.
DATABASE_URL=postgresql://vora:vora@localhost:5432/vora

# Base des tests d'intégration : créée et détruite par `npm test`. Par défaut, c'est la base
# ci-dessus suffixée _test (vora_test) sur le même serveur — ne décommentez que si vous en voulez
# une autre, et donnez-lui impérativement un nom différent de la base de développement.
# TEST_DATABASE_URL=postgresql://vora:vora@localhost:5432/vora_test

# Utilisées uniquement par infra/docker/docker-compose.prod.yml (déploiement cible).
POSTGRES_USER=vora
POSTGRES_PASSWORD=vora
POSTGRES_DB=vora

# ─── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TZ=Africa/Douala
# Origines autorisées pour l'admin web et la page de partage de trajet (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Sécurité ─────────────────────────────────────────────────────────────────
# À remplacer par une valeur aléatoire : openssl rand -hex 32
JWT_SECRET=changeme-dev-only
JWT_EXPIRES_IN=24h
# Signature HMAC du devis : garantit que le prix ferme n'a pas été modifié par le client
QUOTE_HMAC_SECRET=changeme-dev-only

# ─── Mode démonstration ───────────────────────────────────────────────────────
# true : le code OTP vaut toujours DEMO_OTP_CODE, il est renvoyé dans la réponse et affiché en log,
#        le simulateur de chauffeurs et les endpoints /v1/demo/* sont actifs.
# false : comportement de production. Le produit doit fonctionner sans le simulateur.
DEMO_MODE=true
DEMO_OTP_CODE=123456
# Jeton exigé sur POST /v1/demo/reset et /v1/demo/scenario
DEMO_TOKEN=changeme-dev-only
DEMO_DRIVERS_CARS=8
DEMO_DRIVERS_MOTOS=4
# Accélération de la course simulée pendant la démo
DEMO_RIDE_SPEED_FACTOR=8

# ─── Routage : OSRM public, repli haversine ───────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=2000
# Repli si OSRM échoue ou dépasse le délai : distance à vol d'oiseau × facteur, à cette vitesse
FALLBACK_DISTANCE_FACTOR=1.35
FALLBACK_SPEED_KMH=22

# ─── Dispatch (valeurs du brief § 6 — ne pas modifier sans changer CLAUDE.md) ──
DISPATCH_OFFER_TIMEOUT_S=15
DISPATCH_MAX_WAVES=3
DISPATCH_RADII_KM=1,3,5
DRIVER_POSITION_TTL_S=60
REALTIME_REPLAY_BUFFER_MIN=10

# ─── Tarification ─────────────────────────────────────────────────────────────
QUOTE_TTL_S=120
# Majoration pluie : activée par la page ops, valeur en pourcentage (plafond global × 1,5)
SURGE_RAIN_PERCENT=50

# ─── Paiement ─────────────────────────────────────────────────────────────────
# simulated : adaptateur de démonstration (attente puis succès). Aucune API opérateur réelle.
PAYMENT_PROVIDER=simulated
PAYMENT_SIMULATED_DELAY_MS=3000

# ─── Partage de trajet ────────────────────────────────────────────────────────
# Base de l'URL publique renvoyée par POST /v1/rides/{id}/share
SHARE_BASE_URL=http://localhost:3000/share

# ─── Admin web (apps/admin, Vite) ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
